# Exemplo para desenvolvimento local. Copie para .env e troque os valores pelos
# do painel Meta for Developers. Não publique este arquivo preenchido.
# Para produção (SQLite e volume persistente), siga docs/hospedagem-v1.md.
WHATSAPP_VERIFY_TOKEN=crie-uma-frase-secreta-aqui
WHATSAPP_ACCESS_TOKEN=token-de-acesso-da-meta
WHATSAPP_PHONE_NUMBER_ID=id-do-numero-do-whatsapp
META_APP_SECRET=chave-secreta-do-aplicativo-meta
# Consulte no painel da Meta a versão atual habilitada para o seu aplicativo.
META_GRAPH_API_VERSION=v23.0

# Encerra somente o atendimento automático; a espera por atendente não expira.
CASTILLA_INACTIVITY_SECONDS=30

# Segredo independente para a interface do atendente encerrar o atendimento humano.
# Deixe vazio para desativar a rota /operator/complete.
OPERATOR_TOKEN=crie-um-token-longo-e-aleatorio-aqui

# Valores aceitos: development ou production.
CASTILLA_ENV=development
# Valores aceitos: jsonl (só desenvolvimento) ou sqlite.
CASTILLA_STORAGE_BACKEND=jsonl
